{
  "name": "neuravic",
  "version": "0.1.0",
  "private": true,
  "description": "Neuravic: marketing website (nfe), backend API (nbe), database migrations (database) and deployment (deployment).",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "nbe",
    "database",
    "test"
  ],
  "scripts": {
    "app": "node scripts/run.mjs",
    "db:local": "npm run postgres:local -w @neuravic/database",
    "db:migrate": "npm run migrate -w @neuravic/database",
    "start": "npm run start -w @neuravic/nbe",
    "dev": "npm run dev -w @neuravic/nbe",
    "smoke": "tsx --env-file-if-exists=.env nbe/scripts/smoke.mts",
    "mail:leads": "tsx --env-file-if-exists=.env nbe/scripts/mail-leads.mts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "security": "node security/scripts/security-check.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run unit -w @neuravic/tests",
    "test:integration": "npm run integration -w @neuravic/tests",
    "test:email": "npm run email -w @neuravic/tests",
    "test:browser": "npm run browser -w @neuravic/tests",
    "test:contact-e2e": "npm run contact-e2e -w @neuravic/tests"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "tsx": "^4.20.0"
  }
}
