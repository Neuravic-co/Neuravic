# Copy to .env.local for local development.

# Where the browser reaches the Neuravic API (NBE).
# Production: leave unset to use same-origin /api/v1 (route neuravic.com/api/* to the NBE Worker).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787/api/v1

# Production on Vercel: leave NEXT_PUBLIC_API_BASE_URL unset. The site then calls /api/v1 on its own domain
# and the built-in proxy (app/api/[...path]) forwards it to API_ORIGIN, so the login cookie stays first-party.

# Where the server (page rendering) reaches NBE to read site content. Optional:
# without it the site renders its built-in content.
API_ORIGIN=http://localhost:8787

# Shared secret for the proxy. Must equal PROXY_SECRET on NBE. It lets NBE trust the visitor address the
# proxy forwards, so rate limits count each visitor separately. Generate one with: openssl rand -base64 32
API_PROXY_SECRET=

# Cloudflare Turnstile site key. Optional: enables the bot check on the contact form
# (set TURNSTILE_SECRET on NBE too).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# The client portal shows an "Under construction" page until this is "true".
# Local development and the browser tests need it on; leave it unset in production until the portal opens.
NEXT_PUBLIC_PORTAL_OPEN=true
