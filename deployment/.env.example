# Copy to deployment/.env (never commit it) and fill in the values.
# Generate the random ones with:  node security/scripts/generate-secrets.mjs

APP_ENV=production
APP_URL=https://www.example.com
ALLOWED_ORIGINS=https://www.example.com
NOTIFY_TO=team@example.com
EMAIL_FROM=Neuravic <no-reply@example.com>
BOOTSTRAP_ADMIN_EMAIL=you@example.com

MYSQL_ROOT_PASSWORD=
APP_DB_PASSWORD=
MIGRATE_DB_PASSWORD=

PRIVACY_HASH_SECRET=
MFA_ENCRYPTION_KEY=
PROXY_SECRET=

# Optional
RESEND_API_KEY=
# Or any mail server: smtps://user%40gmail.com:app-password@smtp.gmail.com:465 (EMAIL_FROM must be that address)
SMTP_URL=
MALWARE_SCANNER_URL=
NEXT_PUBLIC_PORTAL_OPEN=true
