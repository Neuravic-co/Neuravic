# Copy to .env and fill it in. Never commit .env.
# `npm run db:local` creates a working Local Dev .env for you, with fresh random secrets.
# Generate production secrets with: node security/scripts/generate-secrets.mjs

# Local Dev:
# ----------
APP_ENV=development
APP_VERSION=dev
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
HOST=127.0.0.1
PORT=8787
MAINTENANCE_MODE=false
OUTBOX_POLL_MS=2000
PRIVACY_HASH_SECRET=
PROXY_SECRET=
CRON_SECRET=
API_ORIGIN=http://localhost:8787
API_PROXY_SECRET=

# Database:
# ---------
DATABASE_URL=postgres://neuravic_app:CHANGE_ME@127.0.0.1:5433/neuravic
DATABASE_URL_UNPOOLED=postgres://neuravic_migrator:CHANGE_ME@127.0.0.1:5433/neuravic

# Mail (Gmail):
# -------------
# Needs a Google App Password (Google account > Security > 2-Step Verification > App passwords).
# SMTP_URL format: smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
# EMAIL_FROM must be the same Gmail address. NOTIFY_TO is the inbox that receives enquiries.
EMAIL_FROM= neuravic2026@gmail.com
NOTIFY_TO=you@gmail.com
SMTP_URL=
SLACK_WEBHOOK_URL=

# Deployment:
# -----------
TURNSTILE_SECRET=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
VERCEL_API_ORIGIN=
CRON_SCHEDULE=* * * * *
