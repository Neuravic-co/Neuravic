{
  "name": "@neuravic/tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unit tests (no database, no network) and integration tests (the running gateway, services and database).",
  "scripts": {
    "unit": "node --import tsx --test \"unit/**/*.test.ts\"",
    "integration": "node --import tsx --env-file-if-exists=../.env --test --test-concurrency=1 \"integration/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "email": "node --import tsx --test --test-concurrency=1 \"email/**/*.test.ts\"",
    "browser": "node --import tsx --test --test-concurrency=1 \"e2e/**/*.test.ts\"",
    "contact-e2e": "node --import tsx --test \"contact-e2e/**/*.test.ts\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1"
  }
}
