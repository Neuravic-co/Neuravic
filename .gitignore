# ---------------------------------------------------------------------------
# Neuravic repository. Folder-level .gitignore files (NFE, NBE, Test) add
# rules for their own tools; this file covers the whole repository.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output and caches
dist/
out/
.next/
.vinext/
.wrangler/
.turbo/
.cache/
.npm-cache/
.parcel-cache/
*.tsbuildinfo
next-env.d.ts

# Environment files and secrets. Only the *.example templates are committed.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa
id_ed25519

# Logs and debug output
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test output (Test/e2e writes screenshots here)
coverage/
.nyc_output/
playwright-report/
test-results/
Test/e2e/screenshots/
Test/e2e/.tmp/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Editors and tools (share .editorconfig only)
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~
.claude/settings.local.json

# Scratch space
tmp/
temp/
*.tmp
*.bak
