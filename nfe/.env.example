# Copy to .env.local for local development.

# Where the browser reaches the Neuravic API (the NBE gateway).
# In production leave this unset to use same-origin /api/v1 through the built-in server proxy below.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787/api/v1

# With it unset, the site calls /api/v1 on its own domain and the built-in proxy (app/api/[...path])
# forwards it to API_ORIGIN, so the login cookie stays first-party.

# Required HTTPS origin of the API for the built-in API proxy. Without it API requests return 503;
# page rendering alone can still show built-in marketing content. That fallback does not prove API connectivity.
API_ORIGIN=http://localhost:8787

# Shared secret for the proxy. Must equal PROXY_SECRET on the backend. It lets the backend trust the visitor address the
# proxy forwards, so rate limits count each visitor separately. Generate one with: openssl rand -base64 32
API_PROXY_SECRET=


# Public Turnstile site key. Required when testing staging/production intake. Rebuild after changing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
