# Copy to .env.local for local development. Never commit it.

# Where the server-side proxy forwards /api/v1 requests (the backend, HTTPS outside development).
API_ORIGIN=http://localhost:8787

# Must equal PROXY_SECRET on the backend. Lets the backend trust the visitor address for rate limits.
API_PROXY_SECRET=

# Leave empty to call /api/v1 on the site's own domain through the proxy. Set it only to call the API directly.
NEXT_PUBLIC_API_BASE_URL=

# Public Cloudflare Turnstile site key. Required in staging and production. Rebuild after changing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
