{
  "name": "neuravic-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply neuravic-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply neuravic-db --remote",
    "sso:keygen": "node scripts/generate-sso-key.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "overrides": {
    "drizzle-kit": {
      "@esbuild-kit/esm-loader": "npm:tsx@4.23.15"
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261018.1",
    "@libsql/client": "^0.18.0",
    "@types/node": "26.6.5",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "4.151.1"
  }
}
